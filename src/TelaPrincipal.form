<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="TelaPrincipal">
  <grid id="27dc6" binding="painelPrincipal" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="1045" height="908"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <tabbedpane id="3910f" binding="painel1">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <grid id="dc79b" binding="abaVacas" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <tabbedpane title="Vacas"/>
            </constraints>
            <properties/>
            <border type="none" title=""/>
            <children>
              <scrollpane id="ecbf" binding="tabelaVacas">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="4da24" class="javax.swing.JTable" binding="tabelaV">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
          <grid id="d390d" binding="abaBezerros" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <tabbedpane title="Bezerros"/>
            </constraints>
            <properties/>
            <border type="none" title=""/>
            <children>
              <scrollpane id="5426" binding="tabelaBezerros">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="ce14a" class="javax.swing.JTable" binding="tabelaB">
                    <constraints/>
                    <properties/>
                  </component>
                </children>
              </scrollpane>
            </children>
          </grid>
        </children>
      </tabbedpane>
      <grid id="af0b3" binding="painelBotoes" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="1">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="ac2a2" class="javax.swing.JButton" binding="ordenarPlantelButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="Ordenar Plantel"/>
            </properties>
          </component>
          <component id="a29af" class="javax.swing.JButton" binding="editarCampoButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="Editar Campo"/>
            </properties>
          </component>
          <component id="fb11" class="javax.swing.JButton" binding="removerAnimalButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="Remover Animal"/>
            </properties>
          </component>
          <component id="b2180" class="javax.swing.JButton" binding="salvarESairButton" default-binding="true">
            <constraints/>
            <properties>
              <text value="Salvar e Sair"/>
            </properties>
          </component>
        </children>
      </grid>
      <component id="c93d9" class="javax.swing.JButton" binding="btnAlternarTema">
        <constraints border-constraint="North"/>
        <properties>
          <text value="Modo Escuro"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
